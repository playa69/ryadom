{"id": "c01-job", "note": "поиск работы → нашёл работу", "dialogs": [[{"role": "user", "text": "Меня уволили, ищу работу уже месяц"}, {"role": "assistant", "text": "Это непросто."}, {"role": "user", "text": "Рассылаю резюме каждый день"}, {"role": "assistant", "text": "Много сил уходит."}, {"role": "user", "text": "Вечером спасают прогулки"}, {"role": "assistant", "text": "Хорошо, что они есть."}, {"role": "user", "text": "Ладно, пойду спать"}, {"role": "assistant", "text": "Спокойной ночи."}], [{"role": "user", "text": "Ура, я нашёл работу! Буду учителем в школе"}, {"role": "assistant", "text": "Поздравляю!"}, {"role": "user", "text": "Выхожу с понедельника, немного волнуюсь"}, {"role": "assistant", "text": "Волнение понятно."}, {"role": "user", "text": "Прогулки по-прежнему помогают успокоиться"}, {"role": "assistant", "text": "Здорово."}, {"role": "user", "text": "Спасибо, что выслушал"}, {"role": "assistant", "text": "Всегда рад."}]], "final_active": [{"category": "situation", "text": "Нашёл работу учителем в школе"}, {"category": "works", "text": "Помогают прогулки"}], "final_absent": [{"category": "situation", "text": "Ищет работу после увольнения"}]}
{"id": "c02-move", "note": "собирается переезжать → переехала", "dialogs": [[{"role": "user", "text": "Мы собираемся переезжать в Казань в декабре"}, {"role": "assistant", "text": "Большие перемены."}, {"role": "user", "text": "Страшно, но интересно"}, {"role": "assistant", "text": "Понимаю."}, {"role": "user", "text": "Больше всего волнуюсь, найду ли там друзей"}, {"role": "assistant", "text": "Это естественный страх."}, {"role": "user", "text": "Ладно, посмотрим"}, {"role": "assistant", "text": "Я рядом."}], [{"role": "user", "text": "Всё, мы переехали в Казань!"}, {"role": "assistant", "text": "Как ощущения?"}, {"role": "user", "text": "Город красивый, но пока одиноко"}, {"role": "assistant", "text": "Это нормально в начале."}, {"role": "user", "text": "Записалась в хор, чтобы знакомиться"}, {"role": "assistant", "text": "Отличная идея."}, {"role": "user", "text": "Первая репетиция в четверг"}, {"role": "assistant", "text": "Удачи!"}]], "final_active": [{"category": "situation", "text": "Переехала в Казань"}], "final_absent": [{"category": "goal", "text": "Собирается переезжать в Казань в декабре"}]}
