# Локально: скопировать в agent/.env (в git не попадает). Значения секретов в репозитории — плейсхолдеры.

# --- Базовые ---
LOCAL=false
DEBUG=false

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8001
APP_VERSION=0.1.0

# --- Внутренняя авторизация ---
# Обязателен, без него сервис не стартует. Это общий токен между сервисами: тот же его отправляет агенту приложение.
AGENT_INTERNAL_TOKEN=<CHANGE_ME_AGENT_INTERNAL_TOKEN>

# --- Диалоги ---
# Файл SQLite, в который дублируются диалоги: после перезапуска и выката агента они возвращаются. Путь должен лежать на томе
# пода (в k8s PVC agent-data, /data/dialogs.sqlite3). Пусто: диалоги только в памяти и пропадают при перезапуске.
DIALOG_DATABASE_URL=
# Как часто записывать изменения диалогов на диск, мс (50-10000).
DIALOG_DB_FLUSH_MS=500
# Выгрузка неактивных (только с диском): человек без обращений столько секунд уходит из памяти пода и загружается с диска при
# следующем обращении. 0 — не выгружать по сроку.
DIALOG_IDLE_EVICT_SECONDS=1800
# Мягкий потолок числа людей в памяти: сверх него выгружаются самые давние. 0 — без потолка.
DIALOG_MAX_USERS_IN_MEMORY=0
# Как часто проверять, кого выгрузить, с (1-3600).
DIALOG_EVICT_INTERVAL_SECONDS=60

# --- Память процесса ---
# Как часто агент возвращает память системе, с: сборка мусора и malloc_trim (только Linux с glibc; в других ОС остаётся сборка
# мусора). Без этого после нагрузки RSS держится на пике и не опускается. 0: не возвращать (заморозка стартовых объектов для
# сборщика мусора остаётся). Подробно: README.md, «Память процесса».
MEMORY_RECLAIM_SECONDS=60

# --- Темп ответа ---
# Пауза между словами стрима, мс (0 — без паузы).
STREAM_DELAY_MS=60
# Самая длинная голосовая реплика, с (1-600): дальше звук отбрасывается. Клиент закрывает реплику на той же секунде.
VOICE_TURN_MAX_SECONDS=300

# --- Ответы и распознавание речи ---
# Режим (не секрет, лежит в конфиге): proxy | template. proxy: ответы пишет чат-модель, голос распознаёт whisper,
# оба через тот же прокси и тот же ключ AGENT_API_TOKEN, что у озвучки (см. ниже). Не хватает ключа или адреса —
# сервис не стартует. template: без моделей, шаблонные ответы и заглушка вместо распознавания (для разработки).
LLM_MODE=proxy
LLM_BASE_URL=
LLM_CHAT_MODEL=gigachat3.5-432b-a28b
STT_MODEL=whisper-large-v3
# Дольше ждать модель нет смысла: после таймаута агент отвечает шаблоном.
LLM_TIMEOUT_SECONDS=15
# Сколько ждать распознавания реплики, с: реплика бывает до VOICE_TURN_MAX_SECONDS, 15 с на неё мало.
STT_TIMEOUT_SECONDS=120
# Сколько последних сообщений диалога видит модель, предел длины ответа в токенах и «живость» ответов (0-2).
LLM_HISTORY_MESSAGES=12
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7

# --- Озвучка ---
# Режим озвучки (не секрет, лежит в конфиге): qwen | salutespeech. Не хватает ключа — сервис не стартует.
# Для разработки без ключей: espeak (локальный espeak-ng) или none (без озвучки, приложение читает ответы само).
TTS_MODE=qwen
# Голос по умолчанию, пока человек не выбрал другой: male | female
TTS_DEFAULT_VOICE=male
# Пауза между кадрами звука, мс: кадр длится 200 мс, 100 — вдвое быстрее реального времени.
TTS_FRAME_INTERVAL_MS=100
# Сколько озвученных фраз помнить, 0 — не помнить. Все фразы агента прогреваются при старте: клиент
# ждёт начала звука не дольше 0,9 с, а облачный синтез отдаёт первый звук за 1-2 с.
TTS_CACHE_ITEMS=64

# SaluteSpeech (TTS_MODE=salutespeech): нужен ключ авторизации Сбера
SALUTE_SPEECH_AUTH_KEY=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_VOICE_MALE=Bys_24000
SALUTE_SPEECH_VOICE_FEMALE=Nec_24000
SALUTE_SPEECH_TIMEOUT_SECONDS=15
# Путь к корневому сертификату Минцифры (Russian Trusted Root CA), если системного хранилища не хватает:
# сертификаты Сбера подписаны им. Скачать: https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
SALUTE_SPEECH_CA_BUNDLE=

# Qwen TTS через OpenAI-совместимый прокси программы (TTS_MODE=qwen, модель qwen/qwen-audio-3.0-tts-flash).
# Ключ прокси лежит в AGENT_API_TOKEN: он принадлежит только агенту и нужен и чату, и распознаванию.
# Не путать с AGENT_INTERNAL_TOKEN выше.
# У модели свои голоса: loongjohn (мужской) и longanhuan_v3.6 (женский).
QWEN_TTS_BASE_URL=
AGENT_API_TOKEN=<CHANGE_ME_PROXY_KEY>
QWEN_TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE_MALE=loongjohn
QWEN_TTS_VOICE_FEMALE=longanhuan_v3.6
QWEN_TTS_TIMEOUT_SECONDS=30

# espeak-ng (запасной вариант, ставится в контейнер, ключа не нужно; голос роботизированный)
ESPEAK_BINARY=espeak-ng
ESPEAK_VOICE_MALE=ru
ESPEAK_VOICE_FEMALE=ru+f2
ESPEAK_SPEED=150

# --- Gemini Live (речь в речь) ---
# Каким путём идёт голосовой диалог: cascade | gemini_live. cascade: распознавание → чат-модель → озвучка (настраивается
# блоками выше). gemini_live: слушает, отвечает и говорит одна модель Gemini Live (настраивается GEMINI_*); чат и распознавание
# из LLM_* не используются, звук даёт Gemini, а не TTS_MODE.
VOICE_PIPELINE=cascade
# Ключ Gemini API. Обязателен при VOICE_PIPELINE=gemini_live: без него сервис не стартует. Секрет: в репозиторий не кладём.
GEMINI_API_KEY=
# Адрес Gemini API (https://…, без слэша на конце). Пусто — напрямую в Google. Из России Google отвечает «User location is
# not supported»: тогда сюда адрес релея (agent/relay/README.md), например https://203-0-113-7.sslip.io
GEMINI_BASE_URL=
# Токен релея: уходит заголовком X-Relay-Token на GEMINI_BASE_URL, без него релей отвечает 403. Напрямую в Google не нужен.
GEMINI_RELAY_TOKEN=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Голос выбирается по роду (male | female); названия — встроенные голоса Gemini.
GEMINI_LIVE_VOICE_MALE=Charon
GEMINI_LIVE_VOICE_FEMALE=Kore
# Сколько ждать открытия соединения с Gemini Live, с.
GEMINI_CONNECT_TIMEOUT_SECONDS=15
# Сколько ждать расшифровку реплики, мс (0-5000), прежде чем отдать ответ: до этого агент проверяет реплику на кризис.
# Не пришла за это время — реплика считается пустой, ответ отбрасывается.
GEMINI_TRANSCRIPT_WAIT_MS=1000
# Ответ, от которого нет событий дольше этого, с, считается оборванным.
GEMINI_IDLE_TIMEOUT_SECONDS=15
# Экономия на контексте: Gemini оплачивает весь контекст сессии на каждый ход, а голос копится в нём аудио-токенами.
# true: после каждого ответа агент открывает свежую сессию и кладёт в неё прошлые реплики текстом (аудио прошлых ходов не
# копится, цена хода почти не растёт). Заменяет сжатие контекста и возобновление по handle ниже. false: одна долгая сессия.
GEMINI_TEXT_CONTEXT=true
# Как часто менять сессию при GEMINI_TEXT_CONTEXT: после стольких ходов на одной сессии (1 — после каждого ответа). Открытие Google
# считает в лимите токенов в минуту целиком, ход в открытой сессии почти ничего (agent/README.md, «Как часто менять сессию»).
GEMINI_ROTATE_EVERY=4
# Сессия меняется раньше, если аудио в её контексте (input_audio из usage) дошло до этого числа токенов; 0 — только по числу ходов.
GEMINI_ROTATE_AUDIO_TOKENS=1500
# Сколько последних сообщений диалога модель получает текстом при новой сессии (при GEMINI_TEXT_CONTEXT это вся её память о
# разговоре; также после переподключения и смены голоса); 0 — весь диалог.
GEMINI_HISTORY_MESSAGES=40
# «Размышление» модели перед ответом, токены: -1 (по умолчанию) параметр не отправляется, решает Google; 0 выключено (быстрее:
# первый звук 0,79 с вместо 0,96 с, ответы короткие и тёплые); >0 предел. Кризис модель не определяет: его ловит агент.
GEMINI_THINKING_BUDGET=-1
# Длинный разговор: когда контекст сессии подходит к пределу, Google сжимает его скользящим окном (самое старое уходит, начало
# и промпт остаются), и сессия не обрывается. Без сжатия голосовая сессия живёт около 15 минут.
GEMINI_COMPRESSION=true
# При каком размере контекста (токены) сжимать и до какого размера; 0 — решает Google (около 80% окна модели).
GEMINI_COMPRESSION_TRIGGER_TOKENS=0
GEMINI_COMPRESSION_TARGET_TOKENS=0
# Возобновление сессии по handle: контекст разговора переживает переподключение (Google закрывает соединение по GoAway).
# Без handle или если он не принят, модель получает последние GEMINI_HISTORY_MESSAGES сообщений текстом.
# Работает только при GEMINI_TEXT_CONTEXT=false.
GEMINI_SESSION_RESUMPTION=true

# --- Langfuse (self-hosted, ns infra): трейсинг ходов и приёмник расхода моделей ---
# LANGFUSE_ENABLED=false (по умолчанию) — всё выключено, агент работает как раньше. true — оба ключа обязательны (без них сервис не
# стартует); ключи проекта (pk-lf…/sk-lf…) создаются в UI Langfuse и лежат в Secret agent-secrets, не в ConfigMap.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web.infra.svc.cluster.local:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Трейсинг: трасса на каждый ход (токены, задержки этапов). false — тексты реплик в Langfuse НЕ уходят, вместо них число символов и
# слов и длительность речи. true — только для локальной отладки: в проде тексты реплик людей отправлять нельзя.
LANGFUSE_TRACE_TEXT=false
# Отдельный приёмник расхода всех моделей (числа без текстов, README «Расход моделей»). Расход ходов уже идёт в трассах, поэтому
# при включённом трейсинге приёмник по умолчанию выключен: иначе расход в Langfuse считается дважды. true — включить, если трассы
# не нужны, а расход по моделям в Langfuse нужен.
LANGFUSE_USAGE_SINK=false
LANGFUSE_FLUSH_SECONDS=5
# Бюджет входных токенов Gemini Live в минуту (README, «Бюджет токенов в минуту»). Лимит проекта Google один на всех (Tier 2:
# 400000); сверх него Google закрывает соединение кодом 1011 «exceeded your current quota». 0 — учёт выключен целиком.
GEMINI_TPM_LIMIT=0
# false — только мерить (метрики, журнал) и не открывать сессии в паузе после 1011; true — ещё и допуск новых разговоров в каскад
# (нужны LLM_*, STT_MODEL и TTS_MODE/QWEN_TTS_*), сокращение истории и шаблон вместо хода, которому не хватило бюджета.
GEMINI_TPM_ENFORCE=false
# Пороги доли окна от лимита: история короче / новые разговоры в каскад / ход ждёт, потом шаблон (по возрастанию).
GEMINI_TPM_TRIM_AT=0.6
GEMINI_TPM_ADMIT_AT=0.7
GEMINI_TPM_HARD_AT=0.9
# Сообщений истории у новой сессии на уровне trim и выше; сколько ход ждёт места в окне, мс.
GEMINI_HISTORY_MESSAGES_TIGHT=16
GEMINI_TPM_WAIT_MS=1500
# Начальная пауза после отказа Google по квоте, секунды (растёт вдвое до 60); 0 — без паузы. Действует и при GEMINI_TPM_ENFORCE=false.
GEMINI_QUOTA_COOLDOWN_SECONDS=5
# Оценка открытия сессии = байты UTF-8 (промпт + история) / 4 × коэффициент; 0 — открытия не считать.
GEMINI_TPM_OPEN_FACTOR=1.0
# Открывать сессию по audio_start или набранному сообщению, а не заранее (экономит квоту, +около 1 с к первому звуку на набранный текст).
GEMINI_LAZY_OPEN=false
