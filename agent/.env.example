# --- Базовые ---
LOCAL=false
DEBUG=false

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8001
TIMEZONE=Europe/Moscow
APP_VERSION=0.1.0

# --- Логирование ---
LOG_PATH=./logs
LOG_FILE_NAME=app.log
METRIC_PATH=./logs
METRIC_FILE_NAME=app-metric.log
AUDIT_LOG_PATH=./logs
AUDIT_LOG_FILE_NAME=events.log
LOG_ROTATION=10 MB
MASK_ENABLED=true

# --- LLM (OpenAI-совместимый API, Cloud.ru) ---
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=<CHANGE_ME_LLM_API_KEY>
LLM_CHAT_MODEL=<CHANGE_ME_LLM_CHAT_MODEL>
LLM_CLASSIFIER_MODEL=<CHANGE_ME_LLM_CLASSIFIER_MODEL>
LLM_EMBEDDING_MODEL=<CHANGE_ME_LLM_EMBEDDING_MODEL>
LLM_TIMEOUT_SECONDS=30
LLM_IS_HARD_HEALTH=true

# --- SaluteSpeech (ASR/TTS) ---
SALUTE_SPEECH_AUTH_KEY=<CHANGE_ME_SALUTE_SPEECH_AUTH_KEY>
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_TIMEOUT_SECONDS=30
SALUTE_SPEECH_IS_HARD_HEALTH=false
SALUTE_SPEECH_DEFAULT_VOICE=May_24000

# --- PostgreSQL (БД backend, read-only retrieval памяти) ---
PG_HOST=ryadom-db-rw.ryadom-db.svc.cluster.local
PG_PORT=5432
PG_DB=backend
PG_USER=developer
PG_PASSWORD=<CHANGE_ME_PG_PASSWORD>
PG_IS_HARD_HEALTH=true

# --- Redis (Sentinel): TTS-кэш ---
REDIS_ENABLED=true
REDIS_SENTINEL_HOST=redis.ryadom-db.svc.cluster.local
REDIS_SENTINEL_PORT=26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>
REDIS_IS_HARD_HEALTH=true

# --- Внутренняя безопасность ---
AGENT_INTERNAL_TOKEN=<CHANGE_ME_AGENT_INTERNAL_TOKEN>
TURN_TIMEOUT_SECONDS=60

# --- Langfuse ---
LANGFUSE_HOST=http://langfuse-web.infra.svc.cluster.local:3000
LANGFUSE_PUBLIC_KEY=<CHANGE_ME_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<CHANGE_ME_LANGFUSE_SECRET_KEY>
