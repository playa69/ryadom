# Локально: скопировать в agent/.env (в git не попадает). Значения секретов в репозитории — плейсхолдеры.

# --- Базовые ---
LOCAL=false
DEBUG=false

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8001
APP_VERSION=0.1.0

# --- Внутренняя авторизация ---
# Обязателен, без него сервис не стартует. То же значение лежит у вызывающей стороны в AGENT_API_TOKEN.
AGENT_INTERNAL_TOKEN=<CHANGE_ME_AGENT_INTERNAL_TOKEN>

# --- Темп ответа ---
# Пауза между словами стрима, мс (0 — без паузы).
STREAM_DELAY_MS=60

# --- Озвучка ---
# auto: SaluteSpeech, если задан ключ, иначе espeak-ng, если он есть, иначе без озвучки.
# salute | espeak | none — принудительно (недоступный провайдер — сервис не стартует).
TTS_PROVIDER=auto
# Пауза между кадрами звука, мс: кадр длится 200 мс, 100 — вдвое быстрее реального времени.
TTS_FRAME_INTERVAL_MS=100

# espeak-ng (ставится в контейнер, ключа не нужно; голос роботизированный)
ESPEAK_BINARY=espeak-ng
ESPEAK_VOICE=ru
ESPEAK_SPEED=150

# SaluteSpeech (целевой голос). Без ключа озвучка идёт через espeak-ng.
SALUTE_SPEECH_AUTH_KEY=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_VOICE=May_24000
SALUTE_SPEECH_TIMEOUT_SECONDS=15
# Путь к пакету корневых сертификатов, если системного хранилища для сертификатов Сбера не хватает.
SALUTE_SPEECH_CA_BUNDLE=
