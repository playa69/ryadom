# Локально: скопировать в agent/.env (в git не попадает). Значения секретов в репозитории — плейсхолдеры.

# --- Базовые ---
DEBUG=false

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8001
APP_VERSION=0.1.0

# --- Внутренняя авторизация ---
# Обязателен, без него сервис не стартует. Это общий токен между сервисами: тот же его отправляет агенту приложение.
AGENT_INTERNAL_TOKEN=<CHANGE_ME_AGENT_INTERNAL_TOKEN>

# --- Диалоги ---
# Строка подключения PostgreSQL (psycopg), в которую дублируются диалоги: после перезапуска и выката агента они возвращаются.
# Пусто: диалоги только в памяти и пропадают при перезапуске.
DIALOG_DATABASE_URL=
# Как часто записывать изменения диалогов на диск, мс (50-10000).
DIALOG_DB_FLUSH_MS=500
# Выгрузка неактивных (только с диском): человек без обращений столько секунд уходит из памяти пода и загружается с диска при
# следующем обращении. 0 — не выгружать по сроку.
DIALOG_IDLE_EVICT_SECONDS=1800
# Мягкий потолок числа людей в памяти: сверх него выгружаются самые давние. 0 — без потолка.
DIALOG_MAX_USERS_IN_MEMORY=0
# Как часто проверять, кого выгрузить, с (1-3600).
DIALOG_EVICT_INTERVAL_SECONDS=60
# Срок хранения разговоров, дней (от 1): через столько дней после последнего сообщения разговор с итогом помечается удалённым
# (проход раз в час); физически помеченное убирает очистка (app/services/dialog_purge.py).
DIALOG_RETENTION_DAYS=90
# Сколько ждать модель при подведении итога разговора, с.
RECAP_TIMEOUT_SECONDS=20

# --- Память процесса ---
# Как часто агент возвращает память системе, с: сборка мусора и malloc_trim (только Linux с glibc; в других ОС остаётся сборка
# мусора). Без этого после нагрузки RSS держится на пике и не опускается. 0: не возвращать (заморозка стартовых объектов для
# сборщика мусора остаётся). Подробно: README.md, «Память процесса».
MEMORY_RECLAIM_SECONDS=60

# --- Фиксированные фразы и голос клиенту ---
# Пауза между словами фиксированных фраз (кризисный ответ, просьба повторить), мс (0 — без паузы).
STREAM_DELAY_MS=60
# Самая длинная голосовая реплика, с (1-600): дальше звук отбрасывается. Клиент закрывает реплику на той же секунде.
VOICE_TURN_MAX_SECONDS=300
# Голос по умолчанию, пока человек не выбрал другой: male | female
TTS_DEFAULT_VOICE=male
# Пауза между кадрами звука, мс: кадр длится 200 мс, 100 — вдвое быстрее реального времени.
TTS_FRAME_INTERVAL_MS=100
# Сколько озвученных фраз помнить, 0 — не помнить. Все фразы агента (приветствия, кризисный ответ, просьба повторить) озвучивает
# голос Gemini и прогревает при старте: клиент ждёт начала звука не дольше 0,9 с, а сессия Gemini открывается около секунды.
TTS_CACHE_ITEMS=64

# --- Фоновая модель (итоги разговоров и недели, заметки памяти) ---
# Текстовая модель прокси программы (OpenAI-совместимый LiteLLM). Голос ведёт Gemini Live; эта модель с человеком не говорит.
# Нет ключа или адреса — модели нет: итоги не подводятся, заметки не извлекаются, итоги недели отвечают DIGEST_UNAVAILABLE.
# Ключ прокси принадлежит только агенту. Не путать с AGENT_INTERNAL_TOKEN выше.
LLM_BASE_URL=
AGENT_API_TOKEN=<CHANGE_ME_PROXY_KEY>
LLM_CHAT_MODEL=gigachat3.5-432b-a28b
# Дольше ждать модель нет смысла: после таймаута итог не подводится (его можно завести вручную).
LLM_TIMEOUT_SECONDS=15
# Предел длины ответа в токенах и «живость» ответов (0-2).
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7

# --- Память о человеке (Cognee и заметки) ---
COGNEE_BASE_URL=
COGNEE_SERVICE_EMAIL=
COGNEE_SERVICE_PASSWORD=
# Модель извлечения заметок по ходу разговора (по умолчанию LLM_CHAT_MODEL). Извлечение работает всегда, когда задан ключ прокси.
MEMORY_NOTES_MODEL=
# Лимит живых заметок на человека и размер блока памяти в токенах.
MEMORY_NOTES_MAX=200
MEMORY_BRIEF_MAX_TOKENS=1200

# --- Gemini Live (речь в речь, единственный голосовой путь) ---
# Ключ Gemini API. Обязателен: без него сервис не стартует. Секрет: в репозиторий не кладём.
GEMINI_API_KEY=
# Адрес Gemini API (https://…, без слэша на конце). Пусто — напрямую в Google. Из России Google отвечает «User location is
# not supported»: тогда сюда адрес релея (agent/relay/README.md), например https://203-0-113-7.sslip.io
GEMINI_BASE_URL=
# Токен релея: уходит заголовком X-Relay-Token на GEMINI_BASE_URL, без него релей отвечает 403. Напрямую в Google не нужен.
GEMINI_RELAY_TOKEN=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Голос выбирается по роду (male | female); названия — встроенные голоса Gemini.
GEMINI_LIVE_VOICE_MALE=Charon
GEMINI_LIVE_VOICE_FEMALE=Kore
# Сколько ждать открытия соединения с Gemini Live, с.
GEMINI_CONNECT_TIMEOUT_SECONDS=15
# Сколько ждать расшифровку реплики, мс (0-5000), прежде чем отдать ответ: до этого агент проверяет реплику на кризис.
# Не пришла за это время — реплика считается пустой, ответ отбрасывается.
GEMINI_TRANSCRIPT_WAIT_MS=1000
# Ответ, от которого нет событий дольше этого, с, считается оборванным.
GEMINI_IDLE_TIMEOUT_SECONDS=15
# Экономия на контексте: Gemini оплачивает весь контекст сессии на каждый ход, а голос копится в нём аудио-токенами. Поэтому агент
# меняет сессию на свежую и кладёт в неё прошлые реплики текстом (аудио прошлых ходов не копится). Как часто менять: после
# стольких ходов на одной сессии (1 — после каждого ответа). Открытие Google считает в лимите токенов в минуту целиком, ход в
# открытой сессии почти ничего (agent/README.md, «Как часто менять сессию»).
GEMINI_ROTATE_EVERY=4
# Сессия меняется раньше, если аудио в её контексте (input_audio из usage) дошло до этого числа токенов; 0 — только по числу ходов.
GEMINI_ROTATE_AUDIO_TOKENS=1500
# Сколько последних сообщений диалога модель получает текстом при новой сессии (это вся её память о разговоре; также после
# переподключения и смены голоса); 0 — весь диалог.
GEMINI_HISTORY_MESSAGES=40
# «Размышление» модели перед ответом, токены: -1 (по умолчанию) параметр не отправляется, решает Google; 0 выключено (быстрее:
# первый звук 0,79 с вместо 0,96 с, ответы короткие и тёплые); >0 предел. Кризис модель не определяет: его ловит агент.
GEMINI_THINKING_BUDGET=-1
# Длинный разговор: когда контекст сессии подходит к пределу, Google сжимает его скользящим окном (самое старое уходит, начало
# и промпт остаются), и сессия не обрывается (сжатие включено всегда). При каком размере контекста (токены) сжимать и до какого
# размера; 0 — решает Google (около 80% окна модели).
GEMINI_COMPRESSION_TRIGGER_TOKENS=0
GEMINI_COMPRESSION_TARGET_TOKENS=0
# Подсказка языка расшифровки речи человека (коды BCP-47 через запятую); пусто — без подсказки.
GEMINI_INPUT_LANGUAGES=ru-RU
# Модель молчит на голосовую реплику: столько мс ждём, не продолжит ли человек, прежде чем попросить ответить в свежей сессии.
GEMINI_SILENCE_NUDGE_MS=2000

# --- Учёт токенов Gemini ---
# Входные токены Gemini Live в минуту (README, «Учёт токенов в минуту»). Лимит проекта Google один на всех (Tier 2: 400000);
# агент только меряет окно (метрики agent_gemini_tpm_*), поведение разговоров оно не меняет. 0 — учёт выключен целиком.
GEMINI_TPM_LIMIT=0
# Начальная пауза после отказа Google по квоте (1011), секунды (растёт вдвое до 60): в ней новые сессии Gemini не открываются. 0 — без паузы.
GEMINI_QUOTA_COOLDOWN_SECONDS=5
# Оценка открытия сессии = байты UTF-8 (промпт + история) / 4 × коэффициент; 0 — открытия не считать.
GEMINI_TPM_OPEN_FACTOR=1.0

# --- Langfuse (self-hosted, ns infra): трейсинг ходов ---
# Трейсинг включается, когда заданы оба ключа проекта (pk-lf…/sk-lf…; создаются в UI Langfuse и лежат в Secret agent-secrets, не
# в ConfigMap); не задан ни один — выключен, задан один — сервис не стартует. Тексты реплик в Langfuse не уходят никогда: вместо
# них число символов и слов, длительность речи, токены и задержки этапов.
LANGFUSE_HOST=http://langfuse-web.infra.svc.cluster.local:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
