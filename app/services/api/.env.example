# Local API values. Copy to services/api/.env.local, which `pnpm dev:api` (and the API
# started by `pnpm dev`) reads on its own. On servers the env is assembled by the infrastructure from
# a Kubernetes Secret.

APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://ryadom:ryadom@localhost:55433/ryadom

# At least 32 characters. Signs the internal JWTs.
AUTH_SECRET=local-only-auth-secret-change-me-0123456789
# At least 32 characters. Signs the app's access and refresh tokens.
MOBILE_JWT_SECRET=local-only-mobile-jwt-secret-change-me-0123

PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3002
PORT=3002

# Email: locally Mailpit from `pnpm infra:up`, messages are viewable at http://localhost:8026
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Рядом <noreply@ryadom.local>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Rate limits shared by every API process. Off (empty) means each process counts for itself, which is
# fine for one local process. Locally Redis comes with `pnpm infra:up`; in the cluster it is Sentinel:
# REDIS_SENTINEL_HOST is the headless Service, REDIS_MASTER_NAME the master, REDIS_PASSWORD serves both.
# While Redis is unreachable the limits are counted in memory, so a Redis outage does not close login.
REDIS_ENABLED=
REDIS_URL=
REDIS_SENTINEL_HOST=
REDIS_SENTINEL_PORT=
REDIS_MASTER_NAME=
REDIS_PASSWORD=

# Dialog agent. Locally a stub from `pnpm infra:up` (dev/agent-mock).
AGENT_API_URL=http://localhost:8080
AGENT_API_TOKEN=
AGENT_TIMEOUT_MS=10000
DIALOG_IDLE_TIMEOUT_SEC=900
DIALOG_MAX_DURATION_SEC=7200

# Native version gate: meant for a ConfigMap, edited on a store release, not on every
# deploy. 0 (the default when empty) means "no gate, no banner" for that platform. The JS/OTA axis
# needs no variable here at all: it is baked into the image (scripts/build-ota-bundle.mjs) and read
# from disk at startup, not from env.
MOBILE_ANDROID_STORE_URL=
MOBILE_ANDROID_MIN_VERSION_CODE=
MOBILE_ANDROID_LATEST_VERSION_CODE=
MOBILE_ANDROID_DOWNLOAD_URL=
MOBILE_IOS_STORE_URL=
MOBILE_IOS_MIN_VERSION_CODE=
MOBILE_IOS_LATEST_VERSION_CODE=

# The API does not need the admin list; admin has it. Empty here.
ADMIN_EMAILS=
