# Local API values. Copy to services/api/.env.local, which `pnpm dev:api` (and the API
# started by `pnpm dev`) reads on its own. On servers the env is assembled by the infrastructure from
# a Kubernetes Secret.

APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://ryadom:ryadom@localhost:55433/ryadom

# At least 32 characters. Signs the internal JWTs.
AUTH_SECRET=local-only-auth-secret-change-me-0123456789
# At least 32 characters. Signs the app's access and refresh tokens.
MOBILE_JWT_SECRET=local-only-mobile-jwt-secret-change-me-0123

PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3002
PORT=3002

# Email: locally Mailpit from `pnpm infra:up`, messages are viewable at http://localhost:8026
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Рядом <noreply@ryadom.local>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Rate limits shared by every API process. Off (empty) means each process counts for itself, which is
# fine for one local process. Locally Redis comes with `pnpm infra:up`; in the cluster it is Sentinel:
# REDIS_SENTINEL_HOST is the headless Service, REDIS_MASTER_NAME the master, REDIS_PASSWORD serves both.
# While Redis is unreachable the limits are counted in memory, so a Redis outage does not close login.
# Тесты внутри приложения (add-self-check-tests): true включает маршруты /api/self-check; PREVIEW — и тесты на ревью (не для прода)
SELF_CHECK_ENABLED=
SELF_CHECK_PREVIEW=
REDIS_ENABLED=
REDIS_URL=
REDIS_SENTINEL_HOST=
REDIS_SENTINEL_PORT=
REDIS_MASTER_NAME=
REDIS_PASSWORD=

# The hourly job that erases anonymous accounts nobody has opened for 90 days (and the agent's copy of
# their data). On when empty; `true` stops it, for instance while the agent cannot confirm erasures.
ANONYMOUS_PURGE_DISABLED=

# Dialog agent. Locally a stub from `pnpm infra:up` (dev/agent-mock).
AGENT_API_URL=http://localhost:8080
AGENT_API_TOKEN=
AGENT_TIMEOUT_MS=10000

# Sign-in from the Telegram Mini App. The bot token is a secret: it checks the signature of the launch
# data. Empty switches Telegram sign-in off. The max age of the launch data is in seconds (a day when empty).
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SEC=

DIALOG_IDLE_TIMEOUT_SEC=900
DIALOG_MAX_DURATION_SEC=7200
# How often an open dialog checks that its session was not ended (signed out elsewhere, revoked by
# the person or an admin, blocked). One indexed query per open dialog per interval.
DIALOG_SESSION_CHECK_SEC=30
# What the gateway may re-encode the agent's speech into: the client names what it decodes in `hello`
# and gets its first choice among these. Empty means PCM16 only (384 kbit/s); mulaw is 192 kbit/s,
# opus about 24 kbit/s (encoded in a worker thread). pcm16 is always on for clients that name nothing.
DIALOG_AUDIO_CODECS=opus,mulaw
# Opus encoder: complexity 0..10 (default 5) and bitrate in bit/s (default 24000).
DIALOG_OPUS_COMPLEXITY=
DIALOG_OPUS_BITRATE=

# Native version gate: meant for a ConfigMap, edited on a store release, not on every
# deploy. 0 (the default when empty) means "no gate, no banner" for that platform. The JS/OTA axis
# needs no variable here at all: it is baked into the image (scripts/build-ota-bundle.mjs) and read
# from disk at startup, not from env.
MOBILE_ANDROID_STORE_URL=
MOBILE_ANDROID_MIN_VERSION_CODE=
MOBILE_ANDROID_LATEST_VERSION_CODE=
MOBILE_ANDROID_DOWNLOAD_URL=
MOBILE_IOS_STORE_URL=
MOBILE_IOS_MIN_VERSION_CODE=
MOBILE_IOS_LATEST_VERSION_CODE=

# The API does not need the admin list; admin has it. Empty here.
ADMIN_EMAILS=

# Reverse proxies in front of the service that append to X-Forwarded-For. The client address (and
# every per-IP rate limit) is the entry the outermost trusted proxy added, not the first one, which
# the client writes itself. 1 behind a single ingress/gateway (the default), 2 with a CDN in front,
# 0 to ignore the header.
TRUSTED_PROXY_HOPS=1

# Product analytics (PostHog), see docs/analytics.md. Empty POSTHOG_KEY switches it off completely:
# nothing is reported, /api/ingest is a 404 and the clients are told not to load the SDK. The project
# token (phc_...) is public by design; it only lets events in. Locally leave it empty unless you are
# testing analytics, otherwise your clicks land in the real project.
#
# LEGAL RISKS (Russian law) of switching analytics on, in short; a research summary from 2026-10-10, not a
# lawyer's opinion, details and sources in docs/analytics.md ("Правовые риски"):
#  - events with an account id stay personal data of the operator (152-FZ art. 3 p. 1, 9, art. 13.1):
#    "depersonalised" does not mean "not personal data", never call them "anonymous";
#  - a cloud analytics service abroad is a cross-border transfer (art. 3 p. 11, art. 12): Roskomnadzor must be
#    notified BEFORE it starts (part 3), the recipient must give the data of parts 4-5, and processing is
#    delegated by contract (art. 6 part 3);
#  - client events pass through our proxy straight into a foreign database and are recorded nowhere in Russia:
#    localisation risk, art. 18 part 5 (Administrative Code 13.11 part 8: RUB 1-6 m for a company);
#  - no legal basis is settled: the opt-out switch is not consent (art. 9), and art. 6(1) p. 7 / p. 9 are not
#    confirmed in practice for product analytics; since 2025-09-01 consent is a separate document;
#  - tension_* with an account id may count as health data (art. 10: written consent, higher fines).
# Each option below carries its own risk on top of these.
#
# POSTHOG_KEY. Carries all of the above. If the Roskomnadzor notification (art. 12 part 3) is not filed and there
# is no contract with the recipient, the legally safer value is empty: nothing is reported then.
POSTHOG_KEY=
# EU cloud by default. The clients never talk to these hosts: they use our proxy at /api/ingest.
POSTHOG_HOST=
POSTHOG_ASSETS_HOST=
POSTHOG_UI_HOST=
# Optional capabilities, handed to the clients by GET /api/analytics/config (a change reaches open
# clients within five minutes, no rebuild). Defaults in brackets.
#   SESSION_REPLAY [off]  HIGH RISK: recording of behaviour on screen. Even masked it shows layout, pauses and taps
#                         on screens with personal content, possibly the person's state (art. 10: written consent).
#                         Only with a separate consent and an updated policy; also needs "Record user sessions" in PostHog.
#                         The recording's events carry raw page addresses (secret codes among them): scrub them first.
#   AUTOCAPTURE    [off]  MEDIUM: clicks, dead clicks and rage clicks tied to the account id describe behaviour in
#                         detail (art. 5 parts 1-2, proportionality). If the scrubbing ever lets an element's text
#                         through, it is page content, and on conversation/profile screens it is data about the
#                         person (art. 10). Text and links are cut in code; SOS, hotlines and screens with content
#                         carry `ph-no-capture`, overlays (portals, Framework7 dialogs) are in NEVER_CAPTURE, and
#                         every new crisis-path button must carry `ph-no-capture`.
#   HEATMAPS       [off]  MEDIUM until reworked, keep OFF: the SDK takes clicks and mouse moves in the capture
#                         phase and ignores `ph-no-capture`, so a tap on SOS or a hotline becomes a point under the
#                         account id and defeats the anonymous crisis counting. Same cross-border path as the rest.
#   ERROR_TRACKING [on]   LOW-MEDIUM: an error's text and stack could hold page data (a name, typed text in an
#                         engine message, a secret code in a frame's file address), art. 5 part 5 (minimisation).
#                         In code the text is made impersonal and frames keep line, column and a scrubbed address;
#                         clients shipped before 2026-10-10 do not do this.
#   WEB_VITALS     [on]   LOW: load timings and device data; attribution (which element/resource was slowest) is
#                         off and also cut in code.
#   FEATURE_FLAGS  [on; OFF in the ConfigMap]  MEDIUM: the request for flags goes around the scrubbing of events and
#                         carries the stored initial properties of the person (full entry address with its query,
#                         referrer, account id, device id, time zone). Not sent after an opt-out or with "do not
#                         track"; switch flags on only once the body of that request is scrubbed in the proxy.
POSTHOG_SESSION_REPLAY=
POSTHOG_CLICK_CAPTURE=
POSTHOG_HEATMAP_CAPTURE=
POSTHOG_ERROR_TRACKING=
POSTHOG_WEB_VITALS=
POSTHOG_FEATURE_FLAGS=
# Erasing a deleted account's person in PostHog (both are needed, the key is a SECRET, never POSTHOG_KEY:
# POSTHOG_KEY is the public project token and is handed to every visitor). Locally leave them empty.
# RISK of the key: it sits in the environment of a public API; a leaked key with wide rights is a leak of the
# analytics data (art. 19 protection measures; Administrative Code 13.11 parts 15-16, 18: turnover-based fines).
# Use a key with the single scope person:write on this project.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# [on] also erases the person's events. Off keeps the events (profile and recordings still go), so past
# activity can still be counted; they are then pseudonymous while the deletion archive maps the id to a person.
# RISK of off: personal data kept longer than the purpose (art. 5 part 7) and, after withdrawal of consent or
# achievement of the purpose, due for destruction within 30 days (art. 21 parts 4-5).
POSTHOG_ERASE_EVENTS=
