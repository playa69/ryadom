# Local values for the admin app. Copy this file to .env.local.
# On servers the environment is assembled by the infrastructure from a Kubernetes Secret.

# local | prod
APP_ENV=local
LOG_LEVEL=info
PORT=3001
DATABASE_URL=postgres://ryadom:ryadom@localhost:55433/ryadom

# At least 32 characters. The same signing key as the admin session cookie.
AUTH_SECRET=local-only-auth-secret-change-me-0123456789

# Who may sign in. Comma-separated, case does not matter. Empty means nobody can sign in.
ADMIN_EMAILS=admin@ryadom.local

PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3002

# Email: locally this is Mailpit from `pnpm infra:up`, messages land at http://localhost:8026
# smtp is the only transport outside the tests (they use memory, which needs APP_ENV=local).
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Рядом <noreply@ryadom.local>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Deleting an account erases the conversations at the agent, so the admin needs its address too.
AGENT_API_URL=http://localhost:8080
AGENT_API_TOKEN=
AGENT_TIMEOUT_MS=10000

# Reverse proxies in front of the service that append to X-Forwarded-For (see services/api/.env.example).
TRUSTED_PROXY_HOPS=1

# The URL prefix this app is published under on a shared host (for example /admin). Next fixes it
# at BUILD time (basePath), so it is a Docker build arg, not a runtime variable. Empty: own host.
# BASE_PATH=/admin
