{
  "name": "@ryadom/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "«Рядом» — клиент (Framework7 + Capacitor): PWA, Android, iOS. Говорит с services/api по HTTPS/WSS, своего сервера не имеет.",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:client": "vite --mode dev",
    "build": "pnpm build:pwa",
    "build:client": "vite build --mode prod",
    "build:client:dev": "vite build --mode dev",
    "build:pwa": "vite build --mode web",
    "preview:pwa": "vite preview --mode web",
    "build:ota": "node scripts/build-ota-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run --passWithNoTests",
    "cap:sync": "cap sync",
    "android:dev": "node scripts/android.mjs dev",
    "android:live": "node scripts/android.mjs live"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.24",
    "@fontsource-variable/inter": "^5.3.0",
    "@ryadom/analytics": "workspace:*",
    "@ryadom/client-core": "workspace:*",
    "@ryadom/contracts": "workspace:*",
    "@ryadom/design": "workspace:*",
    "@ryadom/self-check": "workspace:*",
    "@twa-dev/sdk": "8.0.2",
    "assert-never": "^1.4.0",
    "framework7": "^9.1.3",
    "framework7-icons": "^5.0.5",
    "framework7-react": "^9.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
