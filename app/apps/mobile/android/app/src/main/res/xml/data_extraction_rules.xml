<?xml version="1.0" encoding="utf-8"?>
<!--
  Ничего не уезжает в облачный бэкап и на новый телефон: в хранилище приложения лежат токены
  сессии, а перенос сессии на другое устройство — это не то, чего ждут от разговора о тяжёлом.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
