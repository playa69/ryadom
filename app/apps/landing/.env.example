# Public addresses of the site. No secrets here and none possible: no database, no core package.

# Where "open the app" leads: the signed-in web app (apps/web). On a shared host it has a path, for
# example https://example.com/app/.
PUBLIC_WEBAPP_URL=http://localhost:3003
# The PWA (the browser build of apps/mobile). The download page links it with install instructions;
# empty means that block is not shown. For example https://example.com/pwa/.
PUBLIC_PWA_URL=http://localhost:3004/pwa/
PUBLIC_SUPPORT_EMAIL=support@ryadom.app
# The API's origin, no path (the same value the API itself uses). Only product analytics reads it:
# the site asks it which analytics are on and sends events through its proxy. On a shared host it
# is the site's own origin.
PUBLIC_APP_URL=http://localhost:3002

# Stores and APK: an empty value means the button is not shown.
PUBLIC_RUSTORE_URL=
PUBLIC_GOOGLE_PLAY_URL=
PUBLIC_APP_STORE_URL=
PUBLIC_ANDROID_APK_URL=
