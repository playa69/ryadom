    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ryadom/analytics": "workspace:*",
    "@ryadom/client-core": "workspace:*",
    "@ryadom/contracts": "workspace:*",
    "@ryadom/design": "workspace:*",
    "@ryadom/ui": "workspace:*",
    "lucide-react": "^1.49.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
