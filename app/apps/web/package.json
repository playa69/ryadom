{
  "name": "@ryadom/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "«Рядом» — веб-приложение (десктопный интерфейс продукта за логином). Ходит в services/api по HTTPS/WSS; лендинг — отдельно, в apps/landing.",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
