# Runtime config of the web app. No secrets here and none possible: no database, no core package.
# Both values are read on every request (not baked in at build time), so one image serves the local
# stack and prod. Without them the app falls back to the local development addresses below.

# The API the browser talks to, REST and WebSocket (ws(s):// is derived from it). No trailing slash.
# It is also the only origin besides 'self' that the Content-Security-Policy connect-src allows.
PUBLIC_API_URL=http://localhost:3002

# The marketing site (apps/landing): the links to the terms and the privacy policy point there.
PUBLIC_WEB_URL=http://localhost:3000

# The URL prefix this app is published under on a shared host (for example /app). Next fixes it at
# BUILD time (basePath), so it is a Docker build arg, not a runtime variable. Empty: own host.
# BASE_PATH=/app
