{
  "name": "@ryadom/analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Продуктовая аналитика «Рядом» (PostHog): каталог событий, очистка свойств и URL от ПДн, обёртки над posthog-js и posthog-node, обратный прокси для ingest. Общий для services/api и всех клиентов.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ryadom/contracts": "workspace:*",
    "posthog-js": "^1.438.4",
    "posthog-node": "^5.55.1"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
