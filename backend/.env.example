# --- Базовые ---
LOCAL=false
DEBUG=false

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Europe/Moscow
APP_VERSION=0.1.0
# JSON-список trusted proxy (plain IP или CIDR pod-сети кластера)
TRUSTED_PROXY_IPS=["10.0.0.0/8"]

# --- Логирование ---
LOG_PATH=./logs
LOG_FILE_NAME=app.log
METRIC_PATH=./logs
METRIC_FILE_NAME=app-metric.log
AUDIT_LOG_PATH=./logs
AUDIT_LOG_FILE_NAME=events.log
LOG_ROTATION=10 MB
MASK_ENABLED=true

# --- PostgreSQL ---
PG_HOST=ryadom-db-rw.ryadom-db.svc.cluster.local
PG_PORT=5432
PG_DB=backend
PG_USER=developer
PG_PASSWORD=<CHANGE_ME_PG_PASSWORD>
PG_IS_HARD_HEALTH=true

# --- Redis (Sentinel) ---
REDIS_ENABLED=true
REDIS_SENTINEL_HOST=redis.ryadom-db.svc.cluster.local
REDIS_SENTINEL_PORT=26379
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>
REDIS_IS_HARD_HEALTH=true

# --- JWT и токены ---
JWT_SECRET_KEY=<CHANGE_ME_JWT_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Привязка email (6-значный код) ---
EMAIL_LINK_CODE_TTL_SECONDS=600
EMAIL_LINK_MAX_ATTEMPTS=5

# --- Антиспам auth-контуров ---
SECURITY_DEVICE_LOGIN_RATE_LIMIT=20
SECURITY_DEVICE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
SECURITY_EMAIL_LOGIN_RATE_LIMIT=10
SECURITY_EMAIL_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SECURITY_EMAIL_LINK_RATE_LIMIT=5
SECURITY_EMAIL_LINK_RATE_LIMIT_WINDOW_SECONDS=3600
SECURITY_PASSWORD_RESET_RATE_LIMIT=1
SECURITY_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=75600
SECURITY_PASSWORD_RESET_COOLDOWN_SECONDS=75600
SECURITY_PASSWORD_RESET_CONFIRM_RATE_LIMIT=10
SECURITY_PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=300
